exports[`/sessions lists the store and opens the highlighted session 1`] = `
" sessions · 2   s-<id>

 ▾ nothing said yet                                                                                            <when>
   make the budgets configurable                                                                    ▎ this tab <when>















 j/k move · Enter open · Esc close · ? keys
"
