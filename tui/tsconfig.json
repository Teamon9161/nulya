{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "allowJs": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // The plugin-host contract (`plugin-api.d.ts`) is written ONCE and read
    // from both sides: a plugin author writes `import type { PluginApi } from
    // "nulya-tui/plugin-api"`, and so does the host that implements it. A
    // second copy of those types inside `src/` would be two answers to one
    // question the first time either moved.
    "paths": { "nulya-tui/plugin-api": ["./plugin-api.d.ts"] },
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src", "test", "plugin-api.d.ts"]
}
